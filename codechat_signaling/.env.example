# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ─── CORS / Origins ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to allow all (dev only).
# In production, set this to your app's origin(s), e.g.:
# CORS_ORIGINS=https://app.ghostmessenger.io,https://ghostmessenger.io
CORS_ORIGINS=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true

# ─── Presence ─────────────────────────────────────────────────────────────────
MAX_SOCKETS_PER_USER=3

# ─── Offline handshake queue ──────────────────────────────────────────────────
QUEUE_ENABLED=true
QUEUE_TTL_MS=30000
QUEUE_MAX_PER_USER=50
QUEUE_SWEEP_INTERVAL_MS=10000

# ─── Rate limiting ────────────────────────────────────────────────────────────
SIGNAL_RATE_WINDOW_MS=1000
SIGNAL_RATE_MAX=30
HTTP_RATE_WINDOW_MS=60000
HTTP_RATE_MAX=100

# ─── Validation ───────────────────────────────────────────────────────────────
USER_CODE_MIN_LEN=4
USER_CODE_MAX_LEN=64
MAX_SIGNAL_BYTES=65536

# ─── ICE / STUN ───────────────────────────────────────────────────────────────
# Comma-separated STUN URLs. Defaults to Google's public STUN if empty.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ─── TURN (optional, recommended for production NAT traversal) ─────────────────
# Option A: coturn REST API ephemeral credentials (recommended).
#   Set TURN_SECRET to the same value as coturn's `static-auth-secret`.
# TURN_URLS=turn:turn.ghostmessenger.io:3478
# TURN_SECRET=replace-with-coturn-static-auth-secret
# TURN_TTL_SECONDS=86400
#
# Option B: static long-term credentials.
# TURN_URLS=turn:turn.ghostmessenger.io:3478
# TURN_USERNAME=codechat
# TURN_CREDENTIAL=replace-with-turn-password

# ─── Shutdown ─────────────────────────────────────────────────────────────────
SHUTDOWN_TIMEOUT_MS=10000
