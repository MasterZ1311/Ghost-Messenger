## Caddyfile for Ghost Messenger production
##
## SETUP REQUIRED:
##   1. Replace `yourdomain.com` on the next line with your actual domain
##      e.g.  signal.ghostmessenger.io
##   2. Optionally add your email for Let's Encrypt renewal alerts.
##   3. Caddy will automatically obtain and renew TLS certificates.

ghostmessenger.duckdns.org {
    tls {
        # Uncomment and add your email for Let's Encrypt renewal alerts:
        # issuer acme {
        #     email you@example.com
        # }
    }

    # Proxy HTTP & WebSocket traffic to the internal signaling service
    reverse_proxy signaling:3000 {
        # Preserve host header for CORS checks
        header_up Host {host}
        # Support WebSocket upgrades
        transport http {
            protocols h2c h1
        }
    }

    # Health check endpoint
    handle_path /health {
        respond "OK" 200
    }
}
